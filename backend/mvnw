#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script, version 3.3.2
# ----------------------------------------------------------------------------

MAVEN_PROJECTBASEDIR=$(cd "$(dirname "$0")" && pwd)
MAVEN_CONFIG="$MAVEN_PROJECTBASEDIR/.mvn"
CLASSWORLDS_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
CLASSWORLDS_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

# Check Maven Wrapper JAR
if [ ! -f "$CLASSWORLDS_JAR" ]; then
    echo "[ERROR] Maven Wrapper JAR not found: $CLASSWORLDS_JAR"
    exit 1
fi

# Find Java
if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
else
    JAVA_EXE=$(which java 2>/dev/null)
fi

if [ ! -x "$JAVA_EXE" ]; then
    echo "[ERROR] Java not found. Please install JDK 17+."
    exit 1
fi

echo "Using Java: $JAVA_EXE"
echo ""

exec "$JAVA_EXE" \
  -classpath "$CLASSWORLDS_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  $CLASSWORLDS_LAUNCHER \
  "$@"
